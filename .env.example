# Flyball environment template
#
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.
#
# IMPORTANT:
# - VITE_* variables are bundled into the browser by Vite.
# - Only use VITE_* for values that are safe to expose publicly.
# - AI, messaging, and server-to-server API keys must stay in a backend or
#   Vercel serverless function environment, not in the Vite client.

# -----------------------------------------------------------------------------
# Supabase — CURRENTLY WIRED
# -----------------------------------------------------------------------------
# Used by Supabase Realtime for multiplayer between different networks and by
# the optional shared leaderboard. The anon/publishable key is designed for
# browser use; protect data with Supabase RLS and never put the service-role key
# in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Server-only AI and messaging integrations
# -----------------------------------------------------------------------------
# These are intentionally NOT prefixed with VITE_. Add them only to the
# backend/Vercel Function that proxies requests from the game.

# OpenAI — per-shot analysis
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini — holistic post-match summary
# Google documents GEMINI_API_KEY and GOOGLE_API_KEY; this project standardizes
# on GEMINI_API_KEY for the future server integration.
GEMINI_API_KEY=
GEMINI_MODEL=

# Backboard.io — per-browser profile memory and trend history
BACKBOARD_API_KEY=
BACKBOARD_API_BASE_URL=https://app.backboard.io/api

# ElevenLabs — narrated coaching
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_NARRATOR_A_VOICE_ID=
ELEVENLABS_NARRATOR_B_VOICE_ID=

# Linq — iMessage/RCS/SMS contact flow
# Linq calls this an integration token in its Partner API documentation.
LINQ_INTEGRATION_TOKEN=
LINQ_SEND_FROM=+14165551234
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v2

# Base10 — mentioned in the plan for post-match analysis, but the image says
# this allocation was not available. Confirm the actual provider and API
# contract before enabling this variable or writing an integration.
BASE10_API_KEY=
BASE10_API_BASE_URL=

# -----------------------------------------------------------------------------
# Optional server runtime settings
# -----------------------------------------------------------------------------
# API_PORT=3001
# APP_ORIGIN=https://your-app.vercel.app
