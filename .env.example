# PaddleLab environment template
#
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.
#
# IMPORTANT:
# - VITE_* variables are bundled into the browser by Vite.
# - Only use VITE_* for values that are safe to expose publicly.
# - AI, messaging, and server-to-server API keys must stay in a backend or
#   Vercel serverless function environment, not in the Vite client.

# -----------------------------------------------------------------------------
# Supabase — CURRENTLY WIRED
# -----------------------------------------------------------------------------
# Used by Supabase Realtime for multiplayer between different networks and by
# the optional shared leaderboard. The anon/publishable key is designed for
# browser use; protect data with Supabase RLS and never put the service-role key
# in a VITE_* variable.
#
# These two are also what make the phone paddle work off-LAN: without them the
# phone link only resolves to the dev server's LAN address, so a phone on
# cellular (or on another Wi-Fi) cannot reach the desktop. Enable Realtime for
# the project, then set both here and in the Vercel project environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# TURN relay — optional, for strict networks
# -----------------------------------------------------------------------------
# Peer-to-peer matches find each other through Supabase and then connect
# directly. On a symmetric NAT (campus, hotel, most cellular carriers) there is
# no direct route to find, and the match falls back to relaying through
# Supabase Realtime instead — playable, with a little more latency.
#
# Adding a TURN server makes those matches direct. Any TURN provider works;
# credentials are short-lived secrets for the browser, so they belong in the
# Vercel environment alongside VITE_SUPABASE_*. VITE_TURN_URL takes one
# address or a comma-separated list.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# Server-only AI and messaging integrations
# -----------------------------------------------------------------------------
# These are intentionally NOT prefixed with VITE_. Add them only to the
# backend/Vercel Function that proxies requests from the game.

# OpenAI — per-shot analysis
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini — holistic post-match summary
# Google documents GEMINI_API_KEY and GOOGLE_API_KEY; this project standardizes
# on GEMINI_API_KEY for the future server integration.
GEMINI_API_KEY=
GEMINI_MODEL=

# Backboard.io — per-browser profile memory and trend history
BACKBOARD_API_KEY=
BACKBOARD_API_BASE_URL=https://app.backboard.io/api

# ElevenLabs — narrated coaching
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_NARRATOR_A_VOICE_ID=
ELEVENLABS_NARRATOR_B_VOICE_ID=

# Linq — iMessage/RCS/SMS contact flow
# Linq calls this an integration token in its Partner API documentation.
LINQ_INTEGRATION_TOKEN=
LINQ_SEND_FROM=+14165551234
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v2

# Baseten — OpenAI-compatible FlyBrain/post-match analysis
# Keep these server-only; the browser must never receive the API key.
BASETEN_API_KEY=
BASETEN_MODEL_ID=zai-org/GLM-5.3-Fast

# Base10 — legacy plan label; not used by the current integration.
BASE10_API_KEY=
BASE10_API_BASE_URL=

# -----------------------------------------------------------------------------
# Tiger Cloud — canonical leaderboard and telemetry
# -----------------------------------------------------------------------------
# Server-only PostgreSQL/TimescaleDB connection. Never use VITE_ here.
# Example only — replace with the connection string from Tiger Cloud.
# Keep this server-only: do not prefix it with VITE_.
TIGER_DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR-TIGER-HOST:5432/YOUR_DATABASE?sslmode=require
TIGER_DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Optional server runtime settings
# -----------------------------------------------------------------------------
# API_PORT=3001
# Restricts browser calls to the leaderboard score-proof and the SMS invite
# endpoint to this origin. Comma-separated for several deployments. When it is
# unset, a request's own host is accepted, which still blocks cross-site posts.
# APP_ORIGIN=https://your-app.vercel.app

# Signs the short-lived token a leaderboard submission must carry. At least 16
# characters; generate with `openssl rand -hex 32`. Without it scores are still
# recorded, but recorded as unverified, so set it before going live.
# SCORE_PROOF_SECRET=
